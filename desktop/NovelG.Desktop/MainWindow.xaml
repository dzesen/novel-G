<Window x:Class="NovelG.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Novel-G" Width="1400" Height="940" MinWidth="375" MinHeight="520"
 WindowStartupLocation="CenterScreen" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Microsoft YaHei" FontSize="14">
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="#F4F3EF" Padding="7,2">
   <MenuItem x:Name="FileMenu"><MenuItem x:Name="StartMenu" Click="Start_Click"/><MenuItem x:Name="StopMenu" Click="Stop_Click" IsEnabled="False"/><Separator/><MenuItem x:Name="ExitMenu" Click="Exit_Click"/></MenuItem>
   <MenuItem x:Name="ViewMenu"><MenuItem x:Name="WorkspaceMenu" Click="Workspace_Click" IsEnabled="False"/><MenuItem x:Name="StatusMenu" Click="Status_Click"/><Separator/><MenuItem x:Name="LogsMenu" Click="Logs_Click"/><MenuItem x:Name="DataMenu" Click="Data_Click"/></MenuItem>
   <MenuItem Header="语言 / Language"><MenuItem Header="简体中文" Click="Chinese_Click"/><MenuItem Header="English" Click="English_Click"/></MenuItem>
  </Menu>
  <Grid>
   <wv:WebView2 x:Name="Browser" Visibility="Collapsed" DefaultBackgroundColor="#FAF9F6"/>
   <ScrollViewer x:Name="StartupView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MaxWidth="720" Margin="26,45,26,36" VerticalAlignment="Center">
     <StackPanel>
      <Path Width="42" Height="42" HorizontalAlignment="Left" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.7" Data="M 3,4 L 12,4 L 12,22 L 3,22 Z M 16,3 L 24,2 L 27,20 L 19,21 Z" Margin="0,0,0,22"/>
      <TextBlock Text="Novel-G" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock x:Name="IntroText" FontSize="17" LineHeight="27" Margin="0,0,0,28"/>
      <Border BorderBrush="#D8D6CE" BorderThickness="0,1,0,1" Padding="0,22" Margin="0,0,0,24">
       <StackPanel>
        <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="StatusDetail" Foreground="#57584F" LineHeight="23"/>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Visibility="Collapsed" Margin="0,18,0,0"/>
       </StackPanel>
      </Border>
      <WrapPanel>
       <Button x:Name="StartButton" Click="Start_Click" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Margin="0,0,12,12"/>
       <Button x:Name="ReturnButton" Click="Workspace_Click" Visibility="Collapsed" Margin="0,0,12,12"/>
       <Button x:Name="LogButton" Click="Logs_Click" Background="Transparent" BorderBrush="#CDCAC0" Margin="0,0,0,12"/>
      </WrapPanel>
      <TextBlock x:Name="LocalText" Foreground="#616258" Margin="0,15,0,8" LineHeight="23"/>
      <TextBlock x:Name="VersionText" Foreground="#616258" FontSize="12"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
